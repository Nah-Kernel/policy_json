{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlobalDiscoveryMustBeStar",
      "Effect": "Allow",
      "Comment": "Cac API list/generate/discover khong ho tro resource-level permission trong AWS IAM - bat buoc Resource=*. Day la nhom duy nhat trong file nay khong the thu hep hon.",
      "Action": [
        "iam:GenerateCredentialReport",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:GenerateOrganizationsAccessReport",
        "iam:ListUsers",
        "iam:ListRoles",
        "iam:ListPolicies",
        "iam:ListGroups",
        "iam:ListAccountAliases",
        "iam:ListVirtualMFADevices",
        "iam:ListOpenIDConnectProviders",
        "iam:ListSAMLProviders",
        "access-analyzer:ListAnalyzers",
        "access-analyzer:ListFindings",
        "organizations:ListAccounts",
        "organizations:ListOrganizationalUnitsForParent",
        "organizations:ListPolicies",
        "organizations:DescribeOrganization",
        "sso:ListInstances",
        "identitystore:ListUsers",
        "identitystore:ListGroups",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ScopedIdentityDetailRead",
      "Effect": "Allow",
      "Comment": "Cac API nay HO TRO resource ARN. Gioi han theo tag audit-scope=true thay vi Resource=* de tuan thu ABAC / Zero Trust.",
      "Action": [
        "iam:GetUser",
        "iam:GetRole",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetGroup",
        "iam:GetGroupPolicy",
        "iam:GetRolePolicy",
        "iam:GetUserPolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListAttachedUserPolicies",
        "iam:ListAttachedGroupPolicies",
        "iam:ListRolePolicies",
        "iam:ListUserPolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListMFADevices",
        "iam:ListAccessKeys",
        "iam:GetAccessKeyLastUsed",
        "iam:SimulatePrincipalPolicy",
        "iam:SimulateCustomPolicy",
        "access-analyzer:GetAnalyzer",
        "access-analyzer:GetFinding",
        "access-analyzer:ValidatePolicy",
        "access-analyzer:CheckAccessNotGranted",
        "access-analyzer:CheckNoNewAccess"
      ],
      "Resource": [
        "arn:aws:iam::*:user/*",
        "arn:aws:iam::*:role/*",
        "arn:aws:iam::*:group/*",
        "arn:aws:iam::*:policy/*",
        "arn:aws:access-analyzer:*:*:analyzer/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/audit-scope": "true"
        }
      }
    },
    {
      "Sid": "SecurityServicesMustBeStar",
      "Effect": "Allow",
      "Comment": "CloudTrail, Config, GuardDuty, SecurityHub o cap account/region khong dinh nghia resource-level permission cho phan lon Describe/Get/List cua chung - buoc phai Resource=*.",
      "Action": [
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:GetEventSelectors",
        "cloudtrail:LookupEvents",
        "cloudtrail:ListTrails",
        "config:DescribeConfigurationRecorders",
        "config:DescribeConfigRules",
        "config:DescribeComplianceByConfigRule",
        "config:GetComplianceDetailsByConfigRule",
        "config:SelectResourceConfig",
        "guardduty:ListDetectors",
        "guardduty:GetDetector",
        "guardduty:ListFindings",
        "guardduty:GetFindings",
        "securityhub:GetFindings",
        "securityhub:DescribeHub",
        "securityhub:GetEnabledStandards",
        "inspector2:ListFindings",
        "inspector2:BatchGetAccountStatus",
        "macie2:GetMacieSession",
        "macie2:ListFindings",
        "macie2:GetFindings",
        "detective:ListGraphs",
        "audit-manager:GetAssessment",
        "audit-manager:ListAssessments",
        "wellarchitected:ListWorkloads",
        "health:DescribeEvents",
        "support:DescribeTrustedAdvisorChecks",
        "support:DescribeTrustedAdvisorCheckResult"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CryptoAndSecretMetadataScoped",
      "Effect": "Allow",
      "Comment": "KMS key va Secrets Manager secret co ARN cu the - gioi han theo tag audit-scope thay vi mo toan bo key/secret trong account.",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy",
        "acm:DescribeCertificate"
      ],
      "Resource": [
        "arn:aws:kms:*:*:key/*",
        "arn:aws:secretsmanager:*:*:secret:*",
        "arn:aws:acm:*:*:certificate/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/audit-scope": "true"
        }
      }
    },
    {
      "Sid": "SecretsListingMustBeStar",
      "Effect": "Allow",
      "Comment": "Cac ham List cua KMS/Secrets Manager khong nhan resource ARN cu the.",
      "Action": [
        "kms:ListKeys",
        "kms:ListAliases",
        "secretsmanager:ListSecrets",
        "acm:ListCertificates"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BillingAlwaysAccountWide",
      "Effect": "Allow",
      "Comment": "Cost Explorer, Budgets khong co khai niem resource-level permission - la du lieu cap account, khong the gan tag rieng le.",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "ce:ListCostCategoryDefinitions",
        "budgets:ViewBudget",
        "budgets:DescribeBudgets",
        "cur:DescribeReportDefinitions",
        "tag:GetResources",
        "tag:GetTagKeys",
        "resource-explorer-2:Search",
        "resource-explorer-2:ListIndexes"
      ],
      "Resource": "*"
    }
  ]
}
