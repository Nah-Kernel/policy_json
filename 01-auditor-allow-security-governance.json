{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndAccessInventory",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:GenerateCredentialReport",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:GenerateOrganizationsAccessReport",
        "iam:SimulateCustomPolicy",
        "iam:SimulatePrincipalPolicy",
        "access-analyzer:Get*",
        "access-analyzer:List*",
        "access-analyzer:ValidatePolicy",
        "access-analyzer:CheckAccessNotGranted",
        "access-analyzer:CheckNoNewAccess",
        "organizations:Describe*",
        "organizations:List*",
        "sso:Describe*",
        "sso:Get*",
        "sso:List*",
        "identitystore:Describe*",
        "identitystore:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": [
        "arn:aws:iam::<account-id>:root",
        "arn:aws:iam::<account-id>:user/*",
        "arn:aws:iam::<account-id>:role/*",
        "arn:aws:iam::<account-id>:policy/*",
        "arn:aws:iam::<account-id>:group/*",
        "arn:aws:iam::<account-id>:instance-profile/*",
        "arn:aws:access-analyzer:<region>:<account-id>:analyzer/<analyzer-name>",
        "arn:aws:organizations::<account-id>:organization/<organization-id>",
        "arn:aws:sso:::instance/<sso-instance-id>",
        "arn:aws:identitystore:<region>:<account-id>:identitystore/<identity-store-id>",
        "arn:aws:sts::<account-id>:assumed-role/<role-name>/*"
      ]
    },
    {
      "Sid": "SecurityAndComplianceServices",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*",
        "cloudtrail:LookupEvents",
        "config:Describe*",
        "config:Get*",
        "config:List*",
        "config:Select*",
        "config:BatchGetResourceConfig",
        "guardduty:Describe*",
        "guardduty:Get*",
        "guardduty:List*",
        "securityhub:Describe*",
        "securityhub:Get*",
        "securityhub:List*",
        "securityhub:BatchGetStandardsControlAssociations",
        "inspector2:BatchGet*",
        "inspector2:Describe*",
        "inspector2:Get*",
        "inspector2:List*",
        "macie2:Describe*",
        "macie2:Get*",
        "macie2:List*",
        "detective:Describe*",
        "detective:Get*",
        "detective:List*",
        "audit-manager:Get*",
        "audit-manager:List*",
        "wellarchitected:Get*",
        "wellarchitected:List*",
        "health:Describe*",
        "support:DescribeTrustedAdvisorCheckResult",
        "support:DescribeTrustedAdvisorChecks",
        "trustedadvisor:Describe*"
      ],
      "Resource": [
        "arn:aws:cloudtrail:<region>:<account-id>:trail/*",
        "arn:aws:config:<region>:<account-id>:config-rule/*",
        "arn:aws:config:<region>:<account-id>:configuration-recorder/*",
        "arn:aws:config:<region>:<account-id>:delivery-channel/*",
        "arn:aws:guardduty:<region>:<account-id>:detector/*",
        "arn:aws:securityhub:<region>:<account-id>:hub/default",
        "arn:aws:inspector2:<region>:<account-id>:owner/<account-id>/report/*",
        "arn:aws:macie2:<region>:<account-id>:classification-job/*",
        "arn:aws:detective:<region>:<account-id>:graph/*",
        "arn:aws:auditmanager:<region>:<account-id>:assessment/*",
        "arn:aws:wellarchitected:<region>:<account-id>:lenses/*",
        "arn:aws:health:<region>::event/*",
        "arn:aws:support:<region>:<account-id>:trusted-advisor-check/*",
        "arn:aws:trustedadvisor:<region>:<account-id>:check/*"
      ]
    },
    {
      "Sid": "CryptoAndSecretMetadataOnly",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:GetPublicKey",
        "kms:List*",
        "acm:Describe*",
        "acm:List*",
        "acm-pca:Describe*",
        "acm-pca:List*",
        "acm-pca:GetPolicy",
        "cloudhsm:Describe*",
        "cloudhsm:List*",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets",
        "secretsmanager:ListSecretVersionIds",
        "secretsmanager:GetResourcePolicy"
      ],
      "Resource": [
        "arn:aws:kms:<region>:<account-id>:key/<key-id>",
        "arn:aws:acm:<region>:<account-id>:certificate/<certificate-id>",
        "arn:aws:acm-pca:<region>:<account-id>:certificate-authority/<ca-id>",
        "arn:aws:cloudhsm:<region>:<account-id>:cluster/*",
        "arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>"
      ]
    },
    {
      "Sid": "BillingAndResourceInventory",
      "Effect": "Allow",
      "Action": [
        "ce:Describe*",
        "ce:Get*",
        "ce:List*",
        "budgets:Describe*",
        "budgets:View*",
        "cur:Describe*",
        "tag:Get*",
        "resource-explorer-2:Get*",
        "resource-explorer-2:List*",
        "resource-explorer-2:Search"
      ],
      "Resource": [
        "arn:aws:ce::<account-id>:cost-and-usage-report/<report-name>",
        "arn:aws:budgets::<account-id>:budget/<budget-name>",
        "arn:aws:cur::<account-id>:report/<report-name>",
        "arn:aws:resourcegroupstaggingapi:<region>:<account-id>:*",
        "arn:aws:resource-explorer-2:<region>:<account-id>:index/*"
      ]
    }
  ]
}

