{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountWideListingMustBeStar",
      "Effect": "Allow",
      "Comment": "S3 ListAllMyBuckets, EC2 Describe* tren toan bo region, va cac ham discovery khac khong nhan ARN cu the - AWS chi chap nhan Resource=*.",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetAccountPublicAccessBlock",
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:GetEbsEncryptionByDefault",
        "ec2:GetEbsDefaultKmsKeyId",
        "autoscaling:DescribeAutoScalingGroups",
        "ecs:ListClusters",
        "ecs:ListTaskDefinitions",
        "eks:ListClusters",
        "ecr:DescribeRepositories",
        "ecr:GetRegistryScanningConfiguration",
        "lambda:ListFunctions",
        "lambda:GetAccountSettings",
        "rds:DescribeDBInstances",
        "rds:DescribeDBClusters",
        "dynamodb:ListTables",
        "elasticache:DescribeCacheClusters",
        "redshift:DescribeClusters",
        "es:ListDomainNames",
        "efs:DescribeFileSystems",
        "elasticloadbalancing:DescribeLoadBalancers",
        "cloudfront:ListDistributions",
        "route53:ListHostedZones",
        "apigateway:GET",
        "cloudformation:ListStacks",
        "cloudformation:DescribeStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3BucketConfigScoped",
      "Effect": "Allow",
      "Comment": "Cac ham S3 nay chi doc CAU HINH bucket (khong phai s3:GetObject) va HO TRO resource ARN - gioi han theo bucket duoc gan tag audit-scope, khong mo cho moi bucket trong account.",
      "Action": [
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketAcl",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketLogging",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketWebsite",
        "s3:GetBucketCORS"
      ],
      "Resource": "arn:aws:s3:::*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/audit-scope": "true"
        }
      }
    },
    {
      "Sid": "ComputeConfigScoped",
      "Effect": "Allow",
      "Comment": "Cac ham Get*/Describe* nay nhan ARN resource cu the (function, repo, stack...) - gioi han theo tag audit-scope thay vi Resource=*.",
      "Action": [
        "lambda:GetPolicy",
        "lambda:GetFunctionConfiguration",
        "ecr:GetRepositoryPolicy",
        "ecr:GetLifecyclePolicy",
        "cloudformation:GetStackPolicy",
        "cloudformation:GetTemplate",
        "rds:DescribeDBSnapshotAttributes",
        "rds:ListTagsForResource",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "backup:DescribeBackupVault",
        "backup:ListRecoveryPointsByBackupVault"
      ],
      "Resource": [
        "arn:aws:lambda:*:*:function:*",
        "arn:aws:ecr:*:*:repository/*",
        "arn:aws:cloudformation:*:*:stack/*",
        "arn:aws:rds:*:*:*",
        "arn:aws:dynamodb:*:*:table/*",
        "arn:aws:backup:*:*:backup-vault:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/audit-scope": "true"
        }
      }
    },
    {
      "Sid": "NetworkEdgeMustBeStar",
      "Effect": "Allow",
      "Comment": "WAF, Shield, Route53Domains la dich vu global/toan tai khoan, phan lon API List/Describe khong nhan resource-level ARN.",
      "Action": [
        "wafv2:ListWebACLs",
        "wafv2:GetWebACL",
        "shield:DescribeSubscription",
        "shield:ListProtections",
        "route53domains:ListDomains",
        "network-firewall:ListFirewalls",
        "globalaccelerator:ListAccelerators"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LoggingAndMonitoringScoped",
      "Effect": "Allow",
      "Comment": "CloudWatch Logs va SSM co ARN cu the theo log-group / instance - gioi han theo tag audit-scope.",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeSubscriptionFilters",
        "logs:GetDataProtectionPolicy",
        "logs:ListTagsForResource",
        "ssm:DescribeInstanceInformation",
        "ssm:GetInventory",
        "ssm:GetPatchBaseline"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:*",
        "arn:aws:ssm:*:*:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/audit-scope": "true"
        }
      }
    },
    {
      "Sid": "EventingMustBeStar",
      "Effect": "Allow",
      "Comment": "CloudWatch metrics, EventBridge, StepFunctions o cap List thuong khong nhan resource ARN rieng.",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "sns:ListTopics",
        "sqs:ListQueues",
        "events:ListRules",
        "states:ListStateMachines",
        "sagemaker:ListEndpoints",
        "sagemaker:ListModels",
        "bedrock:ListFoundationModels"
      ],
      "Resource": "*"
    }
  ]
}
