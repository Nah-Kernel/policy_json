{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputeAndContainers",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetEbsEncryptionByDefault",
        "ec2:GetEbsDefaultKmsKeyId",
        "ec2:SearchTransitGatewayRoutes",
        "autoscaling:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "eks:Describe*",
        "eks:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetRepositoryPolicy",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRegistryScanningConfiguration",
        "lambda:List*",
        "lambda:GetPolicy",
        "lambda:GetFunctionConfiguration",
        "lambda:GetAccountSettings",
        "lambda:GetLayerVersionPolicy",
        "batch:Describe*",
        "batch:List*",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkAndEdge",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:Describe*",
        "cloudfront:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "route53:Get*",
        "route53:List*",
        "route53domains:Get*",
        "route53domains:List*",
        "route53resolver:Get*",
        "route53resolver:List*",
        "apigateway:GET",
        "wafv2:Get*",
        "wafv2:List*",
        "waf:Get*",
        "waf:List*",
        "waf-regional:Get*",
        "waf-regional:List*",
        "shield:Describe*",
        "shield:Get*",
        "shield:List*",
        "network-firewall:Describe*",
        "network-firewall:List*",
        "globalaccelerator:Describe*",
        "globalaccelerator:List*",
        "directconnect:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StorageAndDataStoreConfig",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketAcl",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetAccountPublicAccessBlock",
        "s3:GetBucketLogging",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "s3:GetBucketNotification",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketWebsite",
        "s3:GetBucketCORS",
        "rds:Describe*",
        "rds:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "elasticache:Describe*",
        "elasticache:List*",
        "redshift:Describe*",
        "redshift:View*",
        "es:Describe*",
        "es:Get*",
        "es:List*",
        "efs:Describe*",
        "efs:List*",
        "fsx:Describe*",
        "fsx:List*",
        "backup:Describe*",
        "backup:Get*",
        "backup:List*",
        "glacier:Describe*",
        "glacier:List*",
        "glacier:GetVaultAccessPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppsMessagingAndOps",
      "Effect": "Allow",
      "Action": [
        "sns:Get*",
        "sns:List*",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueues",
        "sqs:ListQueueTags",
        "sqs:ListDeadLetterSourceQueues",
        "kinesis:Describe*",
        "kinesis:List*",
        "events:Describe*",
        "events:List*",
        "states:Describe*",
        "states:List*",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "logs:Describe*",
        "logs:GetLogGroupFields",
        "logs:GetDataProtectionPolicy",
        "logs:ListTagsForResource",
        "ssm:Describe*",
        "ssm:List*",
        "ssm:GetInventory",
        "ssm:GetInventorySchema",
        "ssm:GetPatchBaseline",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:GetStackPolicy",
        "codepipeline:Get*",
        "codepipeline:List*",
        "codedeploy:Get*",
        "codedeploy:List*",
        "sagemaker:Describe*",
        "sagemaker:List*",
        "bedrock:Get*",
        "bedrock:List*"
      ],
      "Resource": "*"
    }
  ]
}
