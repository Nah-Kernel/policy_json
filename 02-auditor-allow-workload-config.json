{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputeAndContainers",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetEbsEncryptionByDefault",
        "ec2:GetEbsDefaultKmsKeyId",
        "ec2:SearchTransitGatewayRoutes",
        "autoscaling:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "eks:Describe*",
        "eks:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetRepositoryPolicy",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRegistryScanningConfiguration",
        "lambda:List*",
        "lambda:GetPolicy",
        "lambda:GetFunctionConfiguration",
        "lambda:GetAccountSettings",
        "lambda:GetLayerVersionPolicy",
        "batch:Describe*",
        "batch:List*",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*"
      ],
      "Resource": [
        "arn:aws:ec2:<region>:<account-id>:instance/<instance-id>",
        "arn:aws:ec2:<region>:<account-id>:volume/<volume-id>",
        "arn:aws:ec2:<region>:<account-id>:snapshot/<snapshot-id>",
        "arn:aws:ec2:<region>:<account-id>:security-group/<security-group-id>",
        "arn:aws:ec2:<region>:<account-id>:vpc/<vpc-id>",
        "arn:aws:autoscaling:<region>:<account-id>:autoScalingGroup:<auto-scaling-group-name>",
        "arn:aws:ecs:<region>:<account-id>:cluster/<cluster-name>",
        "arn:aws:ecs:<region>:<account-id>:service/<cluster-name>/<service-name>",
        "arn:aws:eks:<region>:<account-id>:cluster/<cluster-name>",
        "arn:aws:ecr:<region>:<account-id>:repository/<repository-name>",
        "arn:aws:lambda:<region>:<account-id>:function:<function-name>",
        "arn:aws:lambda:<region>:<account-id>:layer:<layer-name>:<layer-version>",
        "arn:aws:batch:<region>:<account-id>:job-queue/<queue-name>",
        "arn:aws:elasticbeanstalk:<region>:<account-id>:application/<application-name>",
        "arn:aws:elasticbeanstalk:<region>:<account-id>:environment/<application-name>/<environment-name>"
      ]
    },
    {
      "Sid": "NetworkAndEdge",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:Describe*",
        "cloudfront:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "route53:Get*",
        "route53:List*",
        "route53domains:Get*",
        "route53domains:List*",
        "route53resolver:Get*",
        "route53resolver:List*",
        "apigateway:GET",
        "wafv2:Get*",
        "wafv2:List*",
        "waf:Get*",
        "waf:List*",
        "waf-regional:Get*",
        "waf-regional:List*",
        "shield:Describe*",
        "shield:Get*",
        "shield:List*",
        "network-firewall:Describe*",
        "network-firewall:List*",
        "globalaccelerator:Describe*",
        "globalaccelerator:List*",
        "directconnect:Describe*"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:<region>:<account-id>:loadbalancer/app/<load-balancer-name>/<load-balancer-id>",
        "arn:aws:cloudfront::<account-id>:distribution/<distribution-id>",
        "arn:aws:route53:::hostedzone/<hosted-zone-id>",
        "arn:aws:route53domains:<region>:<account-id>:domain/<domain-name>",
        "arn:aws:route53resolver:<region>:<account-id>:resolver-endpoint/<resolver-endpoint-id>",
        "arn:aws:apigateway:<region>::/restapis/<api-id>",
        "arn:aws:wafv2:<region>:<account-id>:regional/webacl/<web-acl-name>/<web-acl-id>",
        "arn:aws:waf-regional:<region>:<account-id>:webacl/<web-acl-id>",
        "arn:aws:shield::<account-id>:protection/<protection-id>",
        "arn:aws:network-firewall:<region>:<account-id>:firewall/<firewall-name>",
        "arn:aws:globalaccelerator:<region>:<account-id>:accelerator/<accelerator-id>",
        "arn:aws:directconnect:<region>:<account-id>:dxcon/<connection-id>"
      ]
    },
    {
      "Sid": "StorageAndDataStoreConfig",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketAcl",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetAccountPublicAccessBlock",
        "s3:GetBucketLogging",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "s3:GetBucketNotification",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketWebsite",
        "s3:GetBucketCORS",
        "rds:Describe*",
        "rds:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "elasticache:Describe*",
        "elasticache:List*",
        "redshift:Describe*",
        "redshift:View*",
        "es:Describe*",
        "es:Get*",
        "es:List*",
        "efs:Describe*",
        "efs:List*",
        "fsx:Describe*",
        "fsx:List*",
        "backup:Describe*",
        "backup:Get*",
        "backup:List*",
        "glacier:Describe*",
        "glacier:List*",
        "glacier:GetVaultAccessPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::<bucket-name>",
        "arn:aws:s3:::<bucket-name>/*",
        "arn:aws:rds:<region>:<account-id>:db:<db-instance-id>",
        "arn:aws:rds:<region>:<account-id>:cluster:<cluster-id>",
        "arn:aws:dynamodb:<region>:<account-id>:table/<table-name>",
        "arn:aws:elasticache:<region>:<account-id>:cluster:<cluster-id>",
        "arn:aws:redshift:<region>:<account-id>:cluster:<cluster-id>",
        "arn:aws:es:<region>:<account-id>:domain/<domain-name>",
        "arn:aws:elasticfilesystem:<region>:<account-id>:file-system/<file-system-id>",
        "arn:aws:fsx:<region>:<account-id>:file-system/<file-system-id>",
        "arn:aws:backup:<region>:<account-id>:backup-vault/<vault-name>",
        "arn:aws:glacier:<region>:<account-id>:vaults/<vault-name>"
      ]
    },
    {
      "Sid": "AppsMessagingAndOps",
      "Effect": "Allow",
      "Action": [
        "sns:Get*",
        "sns:List*",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueues",
        "sqs:ListQueueTags",
        "sqs:ListDeadLetterSourceQueues",
        "kinesis:Describe*",
        "kinesis:List*",
        "events:Describe*",
        "events:List*",
        "states:Describe*",
        "states:List*",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "logs:Describe*",
        "logs:GetLogGroupFields",
        "logs:GetDataProtectionPolicy",
        "logs:ListTagsForResource",
        "ssm:Describe*",
        "ssm:List*",
        "ssm:GetInventory",
        "ssm:GetInventorySchema",
        "ssm:GetPatchBaseline",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:GetStackPolicy",
        "codepipeline:Get*",
        "codepipeline:List*",
        "codedeploy:Get*",
        "codedeploy:List*",
        "sagemaker:Describe*",
        "sagemaker:List*",
        "bedrock:Get*",
        "bedrock:List*"
      ],
      "Resource": [
        "arn:aws:sns:<region>:<account-id>:<topic-name>",
        "arn:aws:sqs:<region>:<account-id>:<queue-name>",
        "arn:aws:kinesis:<region>:<account-id>:stream/<stream-name>",
        "arn:aws:events:<region>:<account-id>:rule/<rule-name>",
        "arn:aws:states:<region>:<account-id>:stateMachine:<state-machine-name>",
        "arn:aws:cloudwatch:<region>:<account-id>:alarm:<alarm-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:<log-group-name>",
        "arn:aws:ssm:<region>:<account-id>:parameter/<parameter-name>",
        "arn:aws:ssm:<region>:<account-id>:patchbaseline/<baseline-id>",
        "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*",
        "arn:aws:codepipeline:<region>:<account-id>:pipeline/<pipeline-name>",
        "arn:aws:codedeploy:<region>:<account-id>:application:<application-name>",
        "arn:aws:sagemaker:<region>:<account-id>:notebook-instance/<notebook-instance-name>",
        "arn:aws:bedrock:<region>:<account-id>:foundation-model/<model-id>",
        "arn:aws:bedrock:<region>:<account-id>:guardrail/<guardrail-id>"
      ]
    }
  ]
}
