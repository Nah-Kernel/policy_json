{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAuditorsFromSecurityAccountWithMFA",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111122223333:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "NumericLessThan": {
          "aws:MultiFactorAuthAge": "3600"
        },
        "StringEquals": {
          "sts:ExternalId": "REPLACE-WITH-RANDOM-GUID",
          "aws:PrincipalOrgID": "o-xxxxxxxxxx"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::111122223333:role/SecurityAuditorEntry*"
        },
        "IpAddress": {
          "aws:SourceIp": [
            "203.0.113.0/24"
          ]
        }
      }
    }
  ]
}
