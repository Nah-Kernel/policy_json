{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDataPlaneReadScopedResources",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectTorrent",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:PartiQLSelect",
        "sqs:ReceiveMessage",
        "kinesis:GetRecords",
        "kinesis:GetShardIterator",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "rds:DownloadDBLogFilePortion",
        "rds:DownloadCompleteDBLogFile",
        "codecommit:GetFile",
        "codecommit:GetFolder",
        "codecommit:GetBlob",
        "codecommit:GitPull",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "lambda:GetFunction",
        "lambda:GetLayerVersion"
      ],
      "Resource": [
        "arn:aws:s3:::*/*",
        "arn:aws:dynamodb:*:${aws:PrincipalAccount}:table/*",
        "arn:aws:dynamodb:*:${aws:PrincipalAccount}:table/*/index/*",
        "arn:aws:sqs:*:${aws:PrincipalAccount}:*",
        "arn:aws:kinesis:*:${aws:PrincipalAccount}:stream/*",
        "arn:aws:logs:*:${aws:PrincipalAccount}:log-group:*",
        "arn:aws:rds:*:${aws:PrincipalAccount}:db:*",
        "arn:aws:codecommit:*:${aws:PrincipalAccount}:*",
        "arn:aws:ecr:*:${aws:PrincipalAccount}:repository/*",
        "arn:aws:lambda:*:${aws:PrincipalAccount}:function:*",
        "arn:aws:lambda:*:${aws:PrincipalAccount}:layer:*:*"
      ]
    },
    {
      "Sid": "DenyDataPlaneAccountLevelAPIs",
      "Effect": "Deny",
      "Action": [
        "ecr:GetAuthorizationToken",
        "macie2:GetSensitiveDataOccurrences",
        "macie2:GetSensitiveDataOccurrencesAvailability"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySecretsAndCryptoMaterialScoped",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParameterHistory",
        "ssm:GetParametersByPath",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:GenerateDataKeyPair",
        "ec2:GetPasswordData",
        "acm:GetCertificate",
        "acm:ExportCertificate",
        "codebuild:BatchGetProjects"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:${aws:PrincipalAccount}:secret:*",
        "arn:aws:ssm:*:${aws:PrincipalAccount}:parameter/*",
        "arn:aws:kms:*:${aws:PrincipalAccount}:key/*",
        "arn:aws:ec2:*:${aws:PrincipalAccount}:instance/*",
        "arn:aws:acm:*:${aws:PrincipalAccount}:certificate/*",
        "arn:aws:codebuild:*:${aws:PrincipalAccount}:project/*"
      ]
    },
    {
      "Sid": "DenyAnyIdentityMutationAndChainingScoped",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Change*",
        "iam:Create*",
        "iam:Deactivate*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Enable*",
        "iam:PassRole",
        "iam:Put*",
        "iam:Remove*",
        "iam:Reset*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Upload*",
        "sts:AssumeRole",
        "sts:AssumeRoleWithSAML",
        "sts:AssumeRoleWithWebIdentity",
        "sts:GetFederationToken",
        "organizations:Leave*",
        "organizations:Move*",
        "organizations:Remove*"
      ],
      "Resource": [
        "arn:aws:iam::${aws:PrincipalAccount}:user/*",
        "arn:aws:iam::${aws:PrincipalAccount}:role/*",
        "arn:aws:iam::${aws:PrincipalAccount}:group/*",
        "arn:aws:iam::${aws:PrincipalAccount}:policy/*",
        "arn:aws:iam::${aws:PrincipalAccount}:mfa/*",
        "arn:aws:iam::*:role/*",
        "arn:aws:sts::${aws:PrincipalAccount}:federated-user/*",
        "arn:aws:organizations::*:account/*/*",
        "arn:aws:organizations::*:ou/*/*"
      ]
    },
    {
      "Sid": "DenyWithoutRecentMFA",
      "Effect": "Deny",
      "NotAction": [
        "sts:GetCallerIdentity",
        "iam:GetUser",
        "iam:ListMFADevices"
      ],
      "Resource": "*",
      "Condition": {
        "BoolIfExists": {
          "aws:MultiFactorAuthPresent": "false"
        }
      }
    },
    {
      "Sid": "DenyOutsideApprovedRegions",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "access-analyzer:*",
        "cloudfront:*",
        "route53:*",
        "route53domains:*",
        "waf:*",
        "shield:*",
        "globalaccelerator:*",
        "support:*",
        "trustedadvisor:*",
        "health:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "s3:ListAllMyBuckets",
        "s3:GetAccountPublicAccessBlock"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "ap-southeast-1",
            "us-east-1"
          ]
        }
      }
    }
  ]
}
